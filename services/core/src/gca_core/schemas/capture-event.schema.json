{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nathan-james-s/gateway-code-attribution/contracts/capture-event.schema.json",
  "title": "Capture message (capture → ingest, NATS subject gca.capture.<gateway_type>)",
  "description": "Fingerprints and metadata only. MUST NOT contain source code, model output text or prompts (Constitution II). Binary values are base64.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["schema", "kind", "instance_id", "seq", "gateway_type", "sent_at"],
      "properties": {
        "schema": { "const": "gca.capture.v2" },
        "kind": { "enum": ["event", "heartbeat", "failure"] },
        "instance_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 0, "description": "Monotonic per instance; gaps = loss (R12)." },
        "gateway_type": { "enum": ["agentgateway", "litellm"] },
        "sent_at": { "type": "string", "format": "date-time" }
      }
    },
    "event": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "kind": { "const": "event" },
        "credential_id": { "type": ["string", "null"], "format": "uuid" },
        "api_format": { "enum": ["openai_chat", "openai_responses", "anthropic_messages", "gemini_native"] },
        "tool_hint": { "type": ["string", "null"], "maxLength": 64 },
        "session_id": { "type": ["string", "null"], "maxLength": 128 },
        "model": { "type": "string", "maxLength": 128 },
        "received_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["captured", "partial"] },
        "failure_cause": { "type": ["string", "null"], "enum": [null, "truncated", "unparsable", "unexpected_format"] },
        "alg": { "type": "integer", "minimum": 1 },
        "key_gen": { "type": "integer", "minimum": 1 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "event_id": { "type": "string", "format": "uuid", "description": "Assigned by capture; shared by the parts of one event." },
        "part": {
          "type": "object",
          "description": "Present when one event's fingerprints are split over several messages (each under the NATS max_payload). Ingest stores them as one capture event.",
          "required": ["index", "count"],
          "additionalProperties": false,
          "properties": { "index": { "type": "integer", "minimum": 1 }, "count": { "type": "integer", "minimum": 2 } }
        },
        "lines": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "object",
            "required": ["t", "l", "x", "m", "b"],
            "additionalProperties": false,
            "properties": {
              "t": { "type": "integer", "description": "tool_call_ordinal" },
              "l": { "type": "integer", "description": "line_ordinal" },
              "x": { "type": "string", "contentEncoding": "base64", "description": "exact_fp, 16 bytes" },
              "m": { "type": "string", "contentEncoding": "base64", "minLength": 684, "maxLength": 684, "description": "MinHash signature: 128 big-endian uint32 values (512 bytes)" },
              "b": { "type": "array", "items": { "type": "string", "contentEncoding": "base64" }, "minItems": 8, "maxItems": 8 },
              "p": { "type": "array", "items": { "type": "string", "contentEncoding": "base64" }, "maxItems": 3, "description": "path_suffix_fps" }
            }
          }
        }
      },
      "required": ["api_format", "model", "received_at", "status", "alg", "key_gen", "event_id", "lines"]
    },
    "heartbeat": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "kind": { "const": "heartbeat" },
        "responses_seen": { "type": "integer", "minimum": 0, "description": "Cumulative responses the instance observed (captured + failed)." },
        "buffer_depth": { "type": "integer", "minimum": 0 },
        "shutting_down": { "type": "boolean" }
      }
    },
    "failure": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "kind": { "const": "failure" },
        "cause": { "enum": ["truncated", "unparsable", "unexpected_format", "buffer_overflow", "publish_failed", "unsupported_combination", "unknown_credential"] },
        "count": { "type": "integer", "minimum": 1 },
        "credential_id": { "type": ["string", "null"], "format": "uuid" },
        "api_format": { "type": ["string", "null"] },
        "tool_hint": { "type": ["string", "null"] },
        "period_start": { "type": "string", "format": "date-time" },
        "period_end": { "type": "string", "format": "date-time" }
      },
      "required": ["cause", "count", "period_start", "period_end"]
    }
  }
}
