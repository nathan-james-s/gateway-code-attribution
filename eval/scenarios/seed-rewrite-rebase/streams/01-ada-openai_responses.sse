data: {"type": "response.function_call_arguments.done", "sequence_number": 71, "item_id": "fc_0", "output_index": 0, "arguments": "{\"path\": \"src/rebase_orders.py\", \"content\": \"def order_total(order):\\n    lines = order.get('lines', [])\\n    gross = sum(line['price'] * line['qty'] for line in lines)\\n    discount = order.get('discount_cents', 0)\\n    return max(gross - discount, 0)\\n\\n\\ndef is_paid(order):\\n    return order.get('status') in ('paid', 'refunded')\\n\"}"}

