data: {"type": "response.completed", "sequence_number": 129, "response": {"id": "resp_demo", "object": "response", "created_at": 1, "model": "demo", "status": "completed", "output": [{"type": "function_call", "id": "fc_0", "call_id": "call_001", "name": "write_file", "arguments": "{\"path\": \"src/rebase_orders.py\", \"content\": \"def order_total(order):\\n    lines = order.get('lines', [])\\n    gross = sum(line['price'] * line['qty'] for line in lines)\\n    discount = order.get('discount_cents', 0)\\n    return max(gross - discount, 0)\\n\\n\\ndef is_paid(order):\\n    return order.get('status') in ('paid', 'refunded')\\n\"}", "status": "completed"}, {"type": "function_call", "id": "fc_1", "call_id": "call_002", "name": "write_file", "arguments": "{\"path\": \"src/rebase_shipping.py\", \"content\": \"RATES = {'standard': 499, 'express': 1299, 'overnight': 2499}\\n\\n\\ndef shipping_cents(method, weight_kg):\\n    base = RATES[method]\\n    surcharge = max(0, round((weight_kg - 2) * 150))\\n    return base + surcharge\\n\"}", "status": "completed"}], "usage": {"input_tokens": 10, "input_tokens_details": {"cached_tokens": 0}, "output_tokens": 50, "output_tokens_details": {"reasoning_tokens": 0}, "total_tokens": 60}}}

